{
  "name": "tidings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,green \"npm run dev -w @tidings/worker\" \"npm run dev -w @tidings/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.root.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present && vitest run --root . --config vitest.root.config.ts",
    "test:e2e": "npm run test:e2e --workspace e2e --if-present",
    "db:migrate:local": "npm run db:migrate:local -w @tidings/worker",
    "db:seed:local": "echo 'db:seed:local arrives with TID-004'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.12.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
