{
  "name": "@tidings/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --port 8787 --infer-origin-from-routes=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply tidings --local",
    "db:seed:local": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "@tidings/shared": "*",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@cloudflare/workers-types": "5.20261116.1",
    "@tidings/test-utils": "*",
    "wrangler": "4.162.0"
  }
}
