{
  "name": "tidings",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["enable_ctx_exports"], // loopback RPC; confirmed or replaced by TID-003
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidings",
      // Production D1 (Oceania), created 2026-11-17 for TID-024. Not a secret.
      "database_id": "7ed435d8-85d0-4a7c-b149-985649f40849",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "API_RL", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
  ],
  "triggers": { "crons": ["* * * * *", "17 * * * *"] },
  "routes": [{ "pattern": "tidings.mcn.am", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://tidings.mcn.am",
    "RP_ID": "tidings.mcn.am",
    "RP_NAME": "Tidings",
    "MAGIC_LINK_FROM": "signin@tidings.mcn.am",
  },
  // secrets: SETUP_TOKEN, RESEND_API_KEY, MAGIC_LINK_EMAIL (wrangler secret put; TID-053, ADR 0016)
}
